// S/PDIF output on GPIO21 (PCM_DOUT) without a transceiver: the I2S block runs as clock
// producer with 2 x 32-bit slots and sends data that software has already biphase-mark
// coded (one S/PDIF subframe per 32-bit slot, at twice the audio sample rate). Only GPIO21
// is claimed; GPIO18-20 stay free. The codec is the generic linux,spdif-dit stub.
/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2835";

	fragment@0 {
		target = <&i2s_pins>;
		__overlay__ {
			brcm,pins = <21>;
			brcm,function = <4>; /* ALT0 */
		};
	};

	fragment@1 {
		target = <&i2s_clk_producer>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@2 {
		target-path = "/";
		__overlay__ {
			spdif_gpio21_codec: spdif-gpio21-codec {
				compatible = "linux,spdif-dit";
				#sound-dai-cells = <0>;
				status = "okay";
			};
		};
	};

	fragment@3 {
		target = <&sound>;
		__overlay__ {
			compatible = "simple-audio-card";
			i2s-controller = <&i2s_clk_producer>;
			status = "okay";

			simple-audio-card,name = "spdif-gpio21";
			simple-audio-card,format = "i2s";

			simple-audio-card,cpu {
				sound-dai = <&i2s_clk_producer>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
			};

			simple-audio-card,codec {
				sound-dai = <&spdif_gpio21_codec>;
			};
		};
	};
};
