<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="driver.audio.rpi-gpio-spdif"
       name="S/PDIF output on GPIO21 (rpi-gpio-spdif)"
       version="@VERSION@"
       provider-name="ehb">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.service" library="default.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Optical/coaxial S/PDIF out on a Raspberry Pi GPIO, with AC3/DTS passthrough</summary>
    <description lang="en_GB">Kernel driver that encodes S/PDIF in software and sends it out through the PCM/I2S block on GPIO21 (pin 40). Wire a TOSLINK transmitter module (or a coax driver) to GPIO21, 5V and GND. Kodi sees an IEC958 sound card "SPDIFout" and offers AC3/DTS passthrough.[CR][CR]Built for LibreELEC @LEVERSION@ (kernel @KVER@) only: after a LibreELEC update this add-on does nothing until a matching build is installed. Do not run it together with raspdif.</description>
    <platform>linux</platform>
    <license>GPL-2.0-only</license>
    <source>https://github.com/ehb/rpi-gpio-spdif</source>
  </extension>
</addon>
