#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Start/stop helper of the LibreELEC add-on service.rpi-gpio-spdif.
#   start: apply the stock overlay hifiberry-dac, wait for the card sndrpihifiberry and write
#          the ALSA configuration (device hdmi_bmc, the spdifbmc plugin of this add-on)
#   stop:  remove what start wrote and the overlay (the status file only after a clean
#          stop: a failed start leaves its reason for Kodi, see default.py)
#   current: print the effective settings (the line start stores as 'applied'); default.py
#          compares the two to see whether a settings change needs a restart
# Paths and commands can be overridden for tests (see test/test_addon.sh).
ID=service.rpi-gpio-spdif
A=${SPDIF_ADDON:-/storage/.kodi/addons/$ID}
SET=${SPDIF_SETTINGS:-/storage/.kodi/userdata/addon_data/$ID/settings.xml}
CONFD=${SPDIF_CONFD:-/var/lib/alsa/conf.d}
RUN=${SPDIF_RUN:-/run}
PROC=${SPDIF_PROC:-/proc}
DTOVERLAY=${SPDIF_DTOVERLAY:-dtoverlay}
PIDOF=${SPDIF_PIDOF:-pidof}
CARD_WAIT=${SPDIF_CARD_WAIT:-6}

CONF=$CONFD/50-rpi-gpio-spdif.conf
STATUS=$RUN/$ID.status
APPLIED=$RUN/$ID.applied
# the kernel driver add-on writes the same file name with the mark "# written by driver.audio..."
MARK="# written by $ID"
PLUGIN=$A/lib/libasound_module_pcm_spdifbmc.so
OVERLAY=hifiberry-dac
CARD=sndrpihifiberry

DEF_EXTRA=80

log() { echo "rpi-gpio-spdif: $*"; }
# fail: log, leave the reason for the Kodi notification (default.py), exit
fail() { log "$*"; echo "$*" > "$STATUS"; exit 1; }

# setting ID: the text of <setting id="ID">...</setting> in the add-on's settings file,
# trimmed, with XML entities decoded; empty when the file or the entry is missing
setting() {
  [ -r "$SET" ] || return 0
  sed -n "s|.*<setting id=\"$1\"[^>]*>\([^<]*\)</setting>.*|\1|p" "$SET" | head -n 1 |
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
        -e 's/&quot;/"/g' -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&amp;/\&/g'
}

# Validated settings: anything that is not clearly valid falls back to the default (and says
# so in the journal), the value ends up in a configuration file.
load_settings() {
  S_EXTRA=$(setting extra_ms)
  if [ -z "$S_EXTRA" ]; then
    S_EXTRA=$DEF_EXTRA
  elif ! echo "$S_EXTRA" | grep -Eq '^[0-9]{1,3}$' || [ "$S_EXTRA" -gt 500 ]; then
    log "setting extra_ms: '$S_EXTRA' is not 0..500, using $DEF_EXTRA"; S_EXTRA=$DEF_EXTRA
  else
    S_EXTRA=$(expr "$S_EXTRA" + 0)
  fi
}

# the settings as they take effect (after validation), one line
effective() { echo "extra_ms=$S_EXTRA"; }

driver_loaded() { grep -q '^rpi_gpio_spdif ' "$PROC/modules" 2> /dev/null; }
overlay_applied() { "$DTOVERLAY" -l 2> /dev/null | grep -q " $1\$"; }
card_there() { grep -q "$CARD" "$PROC/asound/cards" 2> /dev/null; }

start() {
  rm -f "$STATUS"
  [ -f "$PLUGIN" ] || fail "plugin missing: $PLUGIN"
  if driver_loaded || overlay_applied rpi-gpio-spdif; then
    fail "the kernel driver add-on is active: remove it first"
  fi
  if "$PIDOF" raspdif > /dev/null 2>&1; then
    fail "raspdif is running and drives the same hardware: stop it first"
  fi
  # a file under our name that we did not write is somebody else's: stop leaves it, so does start
  if [ -e "$CONF" ] && ! grep -q "^$MARK" "$CONF" 2> /dev/null; then
    fail "refusing to overwrite $CONF: it was not written by this add-on"
  fi
  load_settings

  overlay_applied $OVERLAY || "$DTOVERLAY" $OVERLAY || fail "applying the overlay $OVERLAY failed"
  i=0
  while ! card_there && [ "$i" -lt "$CARD_WAIT" ]; do sleep 1; i=$((i + 1)); done
  card_there || fail "the sound card $CARD did not appear after the overlay $OVERLAY"

  # /var is a tmpfs on LibreELEC, the directory does not exist before someone makes it
  mkdir -p "$CONFD" || fail "cannot create $CONFD"
  # tmp name without the .conf suffix: alsa-lib only reads *.conf from the directory
  {
    echo "$MARK"
    echo "pcm_type.spdifbmc {"
    echo "  lib \"$PLUGIN\""
    echo "}"
    echo
    echo "# The name has to begin with hdmi: Kodi offers passthrough only on iec958/spdif/hdmi"
    echo "# names, and appends the channel status bytes as arguments."
    echo "pcm.hdmi_bmc {"
    echo "  @args [ AES0 AES1 AES2 AES3 ]"
    echo "  @args.AES0 { type integer default -1 }"
    echo "  @args.AES1 { type integer default -1 }"
    echo "  @args.AES2 { type integer default -1 }"
    echo "  @args.AES3 { type integer default -1 }"
    echo "  type spdifbmc"
    echo "  slave.pcm \"hw:CARD=$CARD\""
    echo "  extra_ms $S_EXTRA"
    echo "  aes0 \$AES0"
    echo "  aes1 \$AES1"
    echo "  aes2 \$AES2"
    echo "  aes3 \$AES3"
    echo "  hint {"
    echo "    show on"
    echo "    description \"S/PDIF on GPIO21\""
    echo "  }"
    echo "}"
  } > "$CONF.tmp" && mv "$CONF.tmp" "$CONF" || fail "cannot write $CONF"

  effective > "$APPLIED" || fail "cannot write $APPLIED"
  log "device hdmi_bmc -> hw:CARD=$CARD, extra_ms $S_EXTRA"
}

stop() {
  # ExecStopPost also runs after a failed start; systemd then passes SERVICE_RESULT other than
  # "success", and the reason in the status file has to survive for Kodi. The next start (or
  # a clean stop) removes it.
  [ "${SERVICE_RESULT:-success}" = success ] && rm -f "$STATUS"
  rm -f "$APPLIED" "$CONF.tmp"
  grep -q "^$MARK" "$CONF" 2> /dev/null && rm -f "$CONF"
  rmdir "$CONFD" 2> /dev/null
  overlay_applied $OVERLAY && "$DTOVERLAY" -r $OVERLAY
  return 0
}

case "$1" in
  start) start ;;
  stop) stop ;;
  current) load_settings > /dev/null; effective ;;
  *) echo "usage: $0 start|stop|current"; exit 2 ;;
esac
