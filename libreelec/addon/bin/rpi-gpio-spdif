#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Start/stop helper of the LibreELEC add-on service.rpi-gpio-spdif.
#   start: apply the add-on's own overlay spdif-gpio21 (only GPIO21, card spdifgpio21); if it
#          does not apply or its card does not appear, remove it again and fall back to the
#          stock overlay hifiberry-dac (card sndrpihifiberry). Then write the ALSA
#          configuration (device hdmi_bmc, the spdifbmc plugin of this add-on)
#   stop:  remove what start wrote; remove the overlay only while its sound card is closed
#          (an add-on update or a settings change restarts the unit while Kodi plays: taking
#          the card away then made Kodi drop the device and switch to HDMI). The status file
#          only after a clean stop: a failed start leaves its reason for Kodi, see default.py
#   current: print the effective settings (the line start stores as 'applied'); default.py
#          compares the two to see whether a settings change needs a restart
# Paths and commands can be overridden for tests (see test/test_addon.sh).
ID=service.rpi-gpio-spdif
A=${SPDIF_ADDON:-/storage/.kodi/addons/$ID}
SET=${SPDIF_SETTINGS:-/storage/.kodi/userdata/addon_data/$ID/settings.xml}
CONFD=${SPDIF_CONFD:-/var/lib/alsa/conf.d}
RUN=${SPDIF_RUN:-/run}
PROC=${SPDIF_PROC:-/proc}
DTOVERLAY=${SPDIF_DTOVERLAY:-dtoverlay}
DTCFG=${SPDIF_DTCFG:-/sys/kernel/config/device-tree/overlays}
PIDOF=${SPDIF_PIDOF:-pidof}
CARD_WAIT=${SPDIF_CARD_WAIT:-6}

CONF=$CONFD/50-rpi-gpio-spdif.conf
STATUS=$RUN/$ID.status
APPLIED=$RUN/$ID.applied
# the kernel driver add-on writes the same file name with the mark "# written by driver.audio..."
MARK="# written by $ID"
PLUGIN=$A/lib/libasound_module_pcm_spdifbmc.so
OVLDIR=$A/overlays
OWN=spdif-gpio21
OWN_CARD=spdifgpio21
STOCK=hifiberry-dac
STOCK_CARD=sndrpihifiberry

DEF_EXTRA=80

log() { echo "rpi-gpio-spdif: $*"; }
# fail: log, leave the reason for the Kodi notification (default.py), exit
fail() { log "$*"; echo "$*" > "$STATUS"; exit 1; }

# setting ID: the text of <setting id="ID">...</setting> in the add-on's settings file,
# trimmed, with XML entities decoded; empty when the file or the entry is missing
setting() {
  [ -r "$SET" ] || return 0
  sed -n "s|.*<setting id=\"$1\"[^>]*>\([^<]*\)</setting>.*|\1|p" "$SET" | head -n 1 |
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
        -e 's/&quot;/"/g' -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&amp;/\&/g'
}

# Validated settings: anything that is not clearly valid falls back to the default (and says
# so in the journal), the value ends up in a configuration file.
load_settings() {
  S_EXTRA=$(setting extra_ms)
  if [ -z "$S_EXTRA" ]; then
    S_EXTRA=$DEF_EXTRA
  elif ! echo "$S_EXTRA" | grep -Eq '^[0-9]{1,3}$' || [ "$S_EXTRA" -gt 500 ]; then
    log "setting extra_ms: '$S_EXTRA' is not 0..500, using $DEF_EXTRA"; S_EXTRA=$DEF_EXTRA
  else
    S_EXTRA=$(expr "$S_EXTRA" + 0)
  fi
}

# the settings as they take effect (after validation), one line
effective() { echo "extra_ms=$S_EXTRA"; }

driver_loaded() { grep -q '^rpi_gpio_spdif ' "$PROC/modules" 2> /dev/null; }
# applied: dtoverlay's list, or the kernel's configfs entry "<n>_NAME" (seen on LibreELEC: after
# a boot the list was empty although the overlay was applied)
overlay_applied() {
  "$DTOVERLAY" -l 2> /dev/null | grep -q " $1\$" ||
    ls "$DTCFG" 2> /dev/null | grep -q "^[0-9][0-9]*_$1\$"
}
card_there() { grep -q "\[$1 *\]" "$PROC/asound/cards" 2> /dev/null; }
# busy: the card's playback device is open (its status is not "closed")
card_busy() {
  s=$PROC/asound/$1/pcm0p/sub0/status
  [ -r "$s" ] && ! grep -q '^closed' "$s"
}
# drop OVERLAY CARD: remove the overlay unless its card is in use
drop() {
  overlay_applied "$1" || return 0
  if card_busy "$2"; then
    log "the sound card $2 is in use: the overlay $1 stays applied"
  else
    "$DTOVERLAY" -r "$1"
  fi
}
# wait_card CARD: up to CARD_WAIT seconds
wait_card() {
  i=0
  while ! card_there "$1" && [ "$i" -lt "$CARD_WAIT" ]; do sleep 1; i=$((i + 1)); done
  card_there "$1"
}

# use_own: the own overlay applied (or already there) and its card up -> CARD set
use_own() {
  [ -f "$OVLDIR/$OWN.dtbo" ] || { log "no $OVLDIR/$OWN.dtbo"; return 1; }
  if ! overlay_applied $OWN; then
    "$DTOVERLAY" -d "$OVLDIR" $OWN || { log "applying the overlay $OWN failed"; return 1; }
  fi
  if ! wait_card $OWN_CARD; then
    log "the sound card $OWN_CARD did not appear after the overlay $OWN"
    "$DTOVERLAY" -r $OWN
    return 1
  fi
  OVERLAY=$OWN; CARD=$OWN_CARD
}

use_stock() {
  overlay_applied $STOCK || "$DTOVERLAY" $STOCK || fail "applying the overlay $STOCK failed"
  wait_card $STOCK_CARD || fail "the sound card $STOCK_CARD did not appear after the overlay $STOCK"
  OVERLAY=$STOCK; CARD=$STOCK_CARD
}

start() {
  rm -f "$STATUS"
  [ -f "$PLUGIN" ] || fail "plugin missing: $PLUGIN"
  if driver_loaded || overlay_applied rpi-gpio-spdif; then
    fail "the kernel driver add-on is active: remove it first"
  fi
  if "$PIDOF" raspdif > /dev/null 2>&1; then
    fail "raspdif is running and drives the same hardware: stop it first"
  fi
  # a file under our name that we did not write is somebody else's: stop leaves it, so does start
  if [ -e "$CONF" ] && ! grep -q "^$MARK" "$CONF" 2> /dev/null; then
    fail "refusing to overwrite $CONF: it was not written by this add-on"
  fi
  load_settings

  # the stock overlay from an earlier start stays in use (switching under a running card is
  # not worth it); otherwise the own overlay first, the stock one as the fallback
  if overlay_applied $STOCK; then
    use_stock
  elif ! use_own; then
    log "falling back to the stock overlay $STOCK"
    use_stock
  fi

  # /var is a tmpfs on LibreELEC, the directory does not exist before someone makes it
  mkdir -p "$CONFD" || fail "cannot create $CONFD"
  # tmp name without the .conf suffix: alsa-lib only reads *.conf from the directory
  {
    echo "$MARK"
    echo "pcm_type.spdifbmc {"
    echo "  lib \"$PLUGIN\""
    echo "}"
    echo
    echo "# biphase-mark coding of the sub-frames that iec958 below builds"
    echo "pcm.hdmi_bmc_coder {"
    echo "  type spdifbmc"
    echo "  slave.pcm \"hw:CARD=$CARD\""
    echo "  extra_ms $S_EXTRA"
    echo "  hint.show off"
    echo "}"
    echo
    echo "# The name has to begin with hdmi: Kodi offers passthrough only on iec958/spdif/hdmi"
    echo "# names, and appends the channel status bytes as arguments. Without them: consumer"
    echo "# PCM, rate filled in by iec958 from the stream."
    echo "pcm.hdmi_bmc {"
    echo "  @args [ AES0 AES1 AES2 AES3 ]"
    echo "  @args.AES0 { type integer default 4 }"
    echo "  @args.AES1 { type integer default 130 }"
    echo "  @args.AES2 { type integer default 0 }"
    echo "  @args.AES3 { type integer default 1 }"
    echo "  type iec958"
    echo "  slave {"
    echo "    pcm \"hdmi_bmc_coder\""
    echo "    format IEC958_SUBFRAME_LE"
    echo "  }"
    echo "  status [ \$AES0 \$AES1 \$AES2 \$AES3 ]"
    echo "  hint {"
    echo "    show on"
    echo "    description \"S/PDIF on GPIO21\""
    echo "  }"
    echo "}"
  } > "$CONF.tmp" && mv "$CONF.tmp" "$CONF" || fail "cannot write $CONF"

  effective > "$APPLIED" || fail "cannot write $APPLIED"
  log "overlay $OVERLAY, device hdmi_bmc -> hw:CARD=$CARD, extra_ms $S_EXTRA"
}

stop() {
  # ExecStopPost also runs after a failed start; systemd then passes SERVICE_RESULT other than
  # "success", and the reason in the status file has to survive for Kodi. The next start (or
  # a clean stop) removes it.
  [ "${SERVICE_RESULT:-success}" = success ] && rm -f "$STATUS"
  rm -f "$APPLIED" "$CONF.tmp"
  grep -q "^$MARK" "$CONF" 2> /dev/null && rm -f "$CONF"
  rmdir "$CONFD" 2> /dev/null
  drop $OWN $OWN_CARD
  drop $STOCK $STOCK_CARD
  return 0
}

case "$1" in
  start) start ;;
  stop) stop ;;
  current) load_settings > /dev/null; effective ;;
  *) echo "usage: $0 start|stop|current"; exit 2 ;;
esac
