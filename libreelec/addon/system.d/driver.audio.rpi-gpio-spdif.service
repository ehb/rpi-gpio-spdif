[Unit]
Description=S/PDIF output on GPIO21 (rpi-gpio-spdif)
After=local-fs.target sys-kernel-config.mount
Before=kodi.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh /storage/.kodi/addons/driver.audio.rpi-gpio-spdif/bin/rpi-gpio-spdif start
ExecStop=/bin/sh /storage/.kodi/addons/driver.audio.rpi-gpio-spdif/bin/rpi-gpio-spdif stop

[Install]
WantedBy=kodi.service
